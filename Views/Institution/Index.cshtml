@model IEnumerable<InstitutionPanel.Models.ViewModels.InstitutionVM>
@inject InstitutionPanel.Core.Interfaces.ICurrentUserService CurrentUser

@{
    ViewData["Title"] = "Institutions";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <h4 class="mb-0">Institutions</h4>

    @if (CurrentUser.IsAuthenticated && CurrentUser.UserType == "SuperAdmin")
    {
        <a asp-controller="Institution" asp-action="Create"
           class="btn btn-primary btn-lg d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle"></i>
            Add Institution
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Contact</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.ContactNo</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <button class="btn btn-sm btn-warning js-edit-institution" data-id="@item.Id">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </button>

                            <button class="btn btn-sm btn-info js-view-institution" data-id="@item.Id">
                                <i class="bi bi-eye me-1"></i> View
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-block d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <p class="mb-1"><strong>Email:</strong> @item.Email</p>
                <p class="mb-1"><strong>Contact:</strong> @item.ContactNo</p>
                <p class="mb-1">
                    <strong>Status:</strong>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </p>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-sm btn-warning flex-fill js-edit-institution" data-id="@item.Id">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </button>
                    <button class="btn btn-sm btn-info flex-fill js-view-institution" data-id="@item.Id">
                        <i class="bi bi-eye me-1"></i> View
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="institutionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-building me-2 text-primary"></i> Institution Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="institutionModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<div id="editInstitutionModalContainer"></div>

@section Scripts {
    <script>
        window.addEventListener('DOMContentLoaded', () => {
             setTimeout(() => {
                 $(".alert").alert('close');
             }, 3000);
         });

         $(document).on("click", ".js-view-institution", function () {
             const id = $(this).data("id");
             const modal = new bootstrap.Modal(document.getElementById('institutionModal'));
             modal.show();

             $("#institutionModalBody").html(`
                 <div class="text-center py-5">
                     <div class="spinner-border text-primary"></div>
                 </div>
             `);

             $("#institutionModalBody").load(`/Institution/Details/${id}`);
         });

         $(document).on("click", ".js-edit-institution", function () {
             const id = $(this).data("id");

             $.get(`/Institution/Edit/${id}`, function(data) {
                 $("#editInstitutionModalContainer").html(data);

                 const modalEl = document.getElementById('editInstitutionModal');
                 const bsModal = new bootstrap.Modal(modalEl);
                 bsModal.show();
             }).fail(function() {
                 alert("Failed to load edit form. Please try again.");
             });
         });
         
         $(document).on("submit", "#editInstitutionForm", function (e) {
             e.preventDefault();
             const form = $(this);
             const submitBtn = form.find('button[type="submit"]');

             submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');

             $.ajax({
                 url: form.attr("action"),
                 type: 'POST',
                 data: form.serialize(),
                 success: function (res) {
                     if (res.success) {
                         // Close modal
                         const modalEl = document.getElementById('editInstitutionModal');
                         const bsModal = bootstrap.Modal.getInstance(modalEl);
                         if (bsModal) {
                             bsModal.hide();
                         }

                         setTimeout(() => {
                             location.reload();
                         }, 300);
                     } else {
                         // Re-render form with validation errors
                         $("#editInstitutionModalContainer").html(res);
                         const modalEl = document.getElementById('editInstitutionModal');
                         const bsModal = new bootstrap.Modal(modalEl);
                         bsModal.show();
                     }
                 },
                 error: function () {
                     submitBtn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i> Save Changes');
                     alert("An unexpected error occurred. Please try again.");
                 }
             });
         });

         $(document).on('hidden.bs.modal', '#editInstitutionModal', function () {
             $("#editInstitutionModalContainer").html('');
             $('.modal-backdrop').remove();
             $('body').removeClass('modal-open').css('padding-right', '');
         });

       
    </script>
}