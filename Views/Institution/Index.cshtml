@model IEnumerable<InstitutionPanel.Models.ViewModels.InstitutionVM>
@inject InstitutionPanel.Core.Interfaces.ICurrentUserService CurrentUser

@{
    ViewData["Title"] = "Institutions";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <h4 class="mb-0">Institutions</h4>

    @if ( CurrentUser.IsAuthenticated && CurrentUser.UserType == "SuperAdmin")
    {
        <a asp-controller="Institution" asp-action="Create"
           class="btn btn-primary btn-lg d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle"></i>
            Add Institution
        </a>
    }
</div>

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Contact</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.ContactNo</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </a>

                            <a href="javascript:void(0)"
                               class="btn btn-sm btn-info js-view-institution"
                               data-id="@item.Id">
                                <i class="bi bi-eye me-1"></i> View
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-block d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <p class="mb-1"><strong>Email:</strong> @item.Email</p>
                <p class="mb-1"><strong>Contact:</strong> @item.ContactNo</p>
                <p class="mb-1">
                    <strong>Status:</strong>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </p>
                <div class="d-flex gap-2 mt-2">
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning flex-fill">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </a>
                    <a href="javascript:void(0)"
                       class="btn btn-sm btn-info flex-fill js-view-institution"
                       data-id="@item.Id">
                        <i class="bi bi-eye me-1"></i> View
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="institutionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-building me-2 text-primary"></i> Institution Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="institutionModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on("click", ".js-view-institution", function () {
            const id = $(this).data("id");

            $("#institutionModal").modal("show");
            $("#institutionModalBody").html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            `);

            $("#institutionModalBody").load(`/Institution/Details/${id}`);
        });
    </script>
}
