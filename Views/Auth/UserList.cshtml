@model IEnumerable<InstitutionPanel.Models.ViewModels.ApplicationUserVM>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <h4 class="mb-0">Users</h4>
  
        <a asp-controller="Auth" asp-action="Register"
           class="btn btn-primary btn-lg d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle"></i>
            Add User
        </a>

</div>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMsg">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Status</th>
                <th>User Type</th>
                <th>Institution</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.FirstName @user.LastName</td>
                    <td>
                        <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                            @(user.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@user.UserType</td>
                    <td>@user.InstitutionName</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <button class="btn btn-sm btn-info js-view-user"
                                    data-id="@user.Id">
                                <i class="bi bi-eye me-1"></i> View
                            </button>

                            <button class="btn btn-sm btn-warning js-edit-user"
                                    data-id="@user.Id">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">User Details</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="userModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Edit User</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editUserModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on("click", ".js-view-user", function () {
            const id = $(this).data("id");
            $("#userModal").modal("show");
            $("#userModalBody").load(`/Auth/UserView/${id}`);
        });

        $(document).on("click", ".js-edit-user", function () {
            const id = $(this).data("id");
            $("#editUserModal").modal("show");
            $("#editUserModalBody").load(`/Auth/EditUser/${id}`);
        });

        $(document).on("submit", "#editUserForm", function (e) {
            e.preventDefault();

            const form = $(this);

            $.post(form.attr("action"), form.serialize())
                .done(function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        $("#editUserModalBody").html(res);
                    }
                });
        });

        window.addEventListener('DOMContentLoaded', () => {
            const alert = document.getElementById('successMsg');
            if (alert) {
                setTimeout(() => {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                }, 3000);
            }
        });

    </script>
}
