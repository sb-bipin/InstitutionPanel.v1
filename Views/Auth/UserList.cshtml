@model IEnumerable<InstitutionPanel.Models.ViewModels.ApplicationUserVM>

@{
    ViewData["Title"] = "Users";
}

<h2 class="mb-4">Users</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Status</th>
                <th>User Type</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.FirstName @user.LastName</td>
                    <td>
                        <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                            @(user.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@user.UserType</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <button class="btn btn-sm btn-info js-view-user"
                                    data-id="@user.Id">
                                <i class="bi bi-eye me-1"></i> View
                            </button>

                            <a asp-controller="Auth"
                               asp-action="EditUser"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">User Details</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="userModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on("click", ".js-view-user", function () {
            const id = $(this).data("id");
            $("#userModal").modal("show");
            $("#userModalBody").load(`/Auth/UserView/${id}`);
        });
    </script>
}
